.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert

# Python & uv virtual environment
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.python-version

# Python Tooling Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
eggs/
.eggs/

# Node.js & Next.js
node_modules/
.next/
out/
.turbo/
.npm/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.vercel

# Databases & Local Storage
*.sqlite3
*.db
celerybeat-schedule
celerybeat.pid

# OS & Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE Settings
.idea/
.vscode/*
